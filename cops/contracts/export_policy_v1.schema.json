{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cops.example/schemas/export-policy/v1.json",
  "title": "COPS AI export privacy policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "field_rules", "destinations"],
  "properties": {
    "schema_version": { "const": "cops.export-policy/v1" },
    "policy_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "field_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "action"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["public", "internal", "personal", "restricted", "secret"] },
          "action": { "enum": ["allow", "redact", "omit", "pseudonymize"] }
        }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sink_id", "destination", "purpose", "permitted_classifications"],
        "properties": {
          "sink_id": { "type": "string", "minLength": 1 },
          "destination": { "enum": ["model_provider", "telemetry", "report", "diagnostic"] },
          "purpose": { "type": "string", "minLength": 1 },
          "permitted_classifications": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["public", "internal", "personal", "restricted", "secret"] }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_stream_bytes": { "type": "integer", "minimum": 1 },
        "max_attachment_bytes": { "type": "integer", "minimum": 1 },
        "max_attachments": { "type": "integer", "minimum": 1 },
        "max_payload_bytes": { "type": "integer", "minimum": 1 },
        "max_payload_depth": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
