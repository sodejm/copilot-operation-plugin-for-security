{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cops.example/schemas/langsmith-query-runs-v2.schema.json",
  "title": "COPS offline LangSmith query-runs v2 projection",
  "$comment": "COPS wrapper around selected fields from the official LangSmith POST /api/v2/runs/query response documented at https://eu.api.smith.langchain.com/redoc; schema_version and source are COPS metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "response"],
  "properties": {
    "schema_version": {"const": "cops.langsmith-query-runs/v2"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "collection_id", "exported_at", "reference"],
      "properties": {
        "tenant": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/]+$"},
        "collection_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "exported_at": {"$ref": "#/$defs/timestamp"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 240,
          "items": {"$ref": "#/$defs/run"}
        },
        "next_cursor": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 2048}
          ]
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "run_type", "start_time", "parent_run_ids", "trace_id", "project_id"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "run_type": {"enum": ["CHAIN", "LLM", "EMBEDDING", "RETRIEVER", "TOOL"]},
        "start_time": {"$ref": "#/$defs/timestamp"},
        "parent_run_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        },
        "trace_id": {"$ref": "#/$defs/uuid"},
        "project_id": {"$ref": "#/$defs/uuid"}
      }
    }
  }
}
