{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sodejm.github.io/copilot-operation-plugin-for-security/schemas/report-export-options.schema.json",
  "title": "COPS report export options",
  "type": "object",
  "additionalProperties": false,
  "required": ["format"],
  "properties": {
    "format": {"enum": ["sarif", "junit", "pr-markdown"]},
    "repository_root": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "source_anchors": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "source-anchor.schema.json"}
    }
  }
}
