{
  "tool": "nmap",
  "version": "7.94",
  "binary": "nmap",
  "provenance": {
    "source": "https://nmap.org",
    "license": "Nmap Public Source License",
    "pinned_revision": "v7.94"
  },
  "execution": {
    "version_args": ["--version"],
    "version_pattern": "Nmap version (?P<version>[0-9]+(?:\\.[0-9]+)*)(?=\\s|$)"
  },
  "supported_environments": ["linux"],
  "actions": {
    "port_scan": {
      "description": "Scan TCP ports on target",
      "base_args": ["-sT", "-Pn", "--max-retries", "1"],
      "parameters": {
        "ports": {
          "type": "string",
          "flag": "-p",
          "required": false,
          "default": "80,443",
          "regex_pattern": "^[0-9,-]+$"
        },
        "timing": {
          "type": "integer",
          "flag": "-T",
          "required": false,
          "default": 3
        },
        "target": {
          "type": "string",
          "required": true,
          "regex_pattern": "^[a-zA-Z0-9_.-]+$"
        }
      }
    }
  }
}
