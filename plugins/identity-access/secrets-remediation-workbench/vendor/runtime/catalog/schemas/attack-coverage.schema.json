{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sodejm/copilot-operation-plugin-for-security/catalog/schemas/attack-coverage.schema.json",
  "title": "COPS MITRE ATT&CK and Attack Flow Coverage Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attck_version",
    "last_updated",
    "description",
    "mappings"
  ],
  "properties": {
    "schema_version": {
      "const": "cops.attack-coverage/v1"
    },
    "attck_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "component_type",
        "component_id",
        "query_or_analytic"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "minLength": 1
        },
        "component_type": {
          "enum": [
            "hunt",
            "rule",
            "skill",
            "command",
            "graph_rule",
            "workflow",
            "intake"
          ]
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "query_or_analytic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "table_or_log",
        "required_fields",
        "onboarding_status"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "table_or_log": {
          "type": "string",
          "minLength": 1
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "onboarding_status": {
          "enum": [
            "onboarded",
            "available_not_onboarded",
            "missing_data_source"
          ]
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "technique_id",
        "technique_name",
        "tactic",
        "platforms",
        "data_component",
        "capability",
        "evidence_sources",
        "coverage_role",
        "coverage_maturity",
        "validation_state",
        "assumptions",
        "known_limitations",
        "last_reviewed",
        "attck_version"
      ],
      "properties": {
        "mapping_id": {
          "type": "string",
          "pattern": "^COPS-COV-[A-Za-z0-9_-]+$"
        },
        "technique_id": {
          "type": "string",
          "pattern": "^T\\d{4}(\\.\\d{3})?$"
        },
        "technique_name": {
          "type": "string",
          "minLength": 1
        },
        "tactic": {
          "enum": [
            "initial-access",
            "execution",
            "persistence",
            "privilege-escalation",
            "defense-evasion",
            "credential-access",
            "discovery",
            "lateral-movement",
            "collection",
            "command-and-control",
            "exfiltration",
            "impact"
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_component": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "evidence_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        },
        "coverage_role": {
          "enum": [
            "detection",
            "investigation",
            "prevention",
            "response"
          ]
        },
        "coverage_maturity": {
          "enum": [
            "production",
            "preview",
            "hypothesis",
            "experimental"
          ]
        },
        "validation_state": {
          "enum": [
            "validated",
            "unverified"
          ]
        },
        "validation_fixture": {
          "type": "string"
        },
        "time_window": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "last_reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "attck_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        }
      }
    }
  }
}
