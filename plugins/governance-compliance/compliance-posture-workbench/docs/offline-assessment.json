{
  "schema_version": "cops.offline-artifact-playbook/v1",
  "package_id": "compliance-posture-workbench",
  "capability": "compliance_evidence",
  "readiness": "experimental",
  "entrypoints": {
    "assessment": "scripts/assess.py",
    "correction_playback": "scripts/demo.py",
    "native_report": "scripts/report.py",
    "package_check": "scripts/validate_package.py"
  },
  "inputs": ["examples/input.json", "examples/correction-cases.json"],
  "outputs": ["cops.artifact-assessment/v1", "cops.assessment-report/v1"],
  "permissions": {"filesystem": "read supplied package files", "network": "none", "subprocess": "none"},
  "limitations": [
    "Offline inspection cannot establish live provider or production readiness.",
    "Content hashes establish internal integrity only, not source authenticity or authorization."
  ]
}
