{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-v2.schema.json",
  "title": "Offline attack path report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "context",
    "coverage",
    "reconciliation",
    "evidence",
    "graph",
    "quarantine",
    "graph_exclusions",
    "supported_paths",
    "candidate_paths",
    "partial_paths",
    "technique_mappings",
    "attack_flow",
    "actions",
    "assumptions",
    "evidence_gaps",
    "alternative_interpretations",
    "human_review",
    "gate_results",
    "search"
  ],
  "properties": {
    "schema_version": {
      "const": "attackpath.report/v2"
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "limits",
        "bytes",
        "files",
        "records",
        "lines"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file_bytes",
            "total_bytes",
            "files",
            "line_bytes",
            "records",
            "json_depth"
          ],
          "properties": {
            "file_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "total_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "line_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "records": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            "json_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "rule_version",
        "rule_sha256",
        "profile_sha256",
        "input_sha256",
        "source_sha256",
        "profile_versions",
        "reference_versions",
        "prompt_versions",
        "run_id",
        "search_policy_sha256"
      ],
      "properties": {
        "tool_version": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        },
        "rule_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "profile_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run_id": {
          "type": "string"
        },
        "search_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "context": {
      "$ref": "input-v1.schema.json#/$defs/analysis_context"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "declared_coverage",
          "independently_verified_complete"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "declared_coverage": {
            "type": "string"
          },
          "independently_verified_complete": {
            "const": false
          }
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "accepted",
        "quarantined",
        "rejected"
      ],
      "properties": {
        "raw": {
          "type": "integer"
        },
        "accepted": {
          "type": "integer"
        },
        "quarantined": {
          "type": "integer"
        },
        "rejected": {
          "type": "integer"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "records-v1.schema.json#/$defs/evidence"
      }
    },
    "graph": {
      "$ref": "records-v1.schema.json#/$defs/graph"
    },
    "quarantine": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "reason"
        ],
        "properties": {
          "source": {
            "$ref": "records-v1.schema.json#/$defs/source_ref"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "graph_exclusions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supported_paths": {
      "type": "array",
      "items": {
        "$ref": "records-v1.schema.json#/$defs/path"
      }
    },
    "candidate_paths": {
      "type": "array",
      "items": {
        "$ref": "records-v1.schema.json#/$defs/path"
      }
    },
    "partial_paths": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "technique_mappings": {
      "type": "array",
      "items": {
        "$ref": "records-v1.schema.json#/$defs/technique_mapping"
      }
    },
    "attack_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "pending_reference_bundle"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "path_id",
          "target_type",
          "target_id",
          "class",
          "proposal",
          "validation",
          "monitoring",
          "investigation",
          "evidence_refs",
          "owner",
          "status",
          "closure_evidence"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "path_id": {
            "type": "string"
          },
          "target_type": {
            "enum": [
              "finding",
              "transition"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "class": {
            "const": "recommendation"
          },
          "proposal": {
            "type": "string"
          },
          "validation": {
            "type": "string"
          },
          "monitoring": {
            "type": "string"
          },
          "investigation": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "null"
          },
          "status": {
            "const": "proposed"
          },
          "closure_evidence": {
            "type": "null"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternative_interpretations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review": {
      "type": "array",
      "items": {
        "$ref": "records-v1.schema.json#/$defs/review"
      }
    },
    "gate_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8"
      ],
      "properties": {
        "G1": {
          "type": "string"
        },
        "G2": {
          "type": "string"
        },
        "G3": {
          "type": "string"
        },
        "G4": {
          "type": "string"
        },
        "G5": {
          "type": "string"
        },
        "G6": {
          "type": "string"
        },
        "G7": {
          "type": "string"
        },
        "G8": {
          "type": "string"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "consumed",
        "complete",
        "stop_reason",
        "ranking_scope"
      ],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expansions",
            "frontier",
            "complete_paths",
            "partial_paths",
            "emitted_paths",
            "report_bytes"
          ],
          "properties": {
            "expansions": {
              "type": "integer",
              "minimum": 1
            },
            "frontier": {
              "type": "integer",
              "minimum": 1
            },
            "complete_paths": {
              "type": "integer",
              "minimum": 1
            },
            "partial_paths": {
              "type": "integer",
              "minimum": 1
            },
            "emitted_paths": {
              "type": "integer",
              "minimum": 1
            },
            "report_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "consumed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expansions",
            "max_frontier",
            "complete_paths",
            "partial_paths",
            "emitted_paths"
          ],
          "properties": {
            "expansions": {
              "type": "integer",
              "minimum": 0
            },
            "max_frontier": {
              "type": "integer",
              "minimum": 0
            },
            "complete_paths": {
              "type": "integer",
              "minimum": 0
            },
            "partial_paths": {
              "type": "integer",
              "minimum": 0
            },
            "emitted_paths": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "ranking_scope": {
          "type": "string"
        }
      }
    }
  }
}
