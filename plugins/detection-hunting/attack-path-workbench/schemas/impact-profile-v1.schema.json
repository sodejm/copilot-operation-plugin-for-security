{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "impact-profile-v1.schema.json",
  "title": "Future approved business impact profile interface; no profile is installed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "approval", "frameworks", "criteria"],
  "properties": {
    "schema_version": {"const": "attackpath.impact_profile/v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "approved_at"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "pattern": "Z$"}
      }
    },
    "frameworks": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["publication_id", "version", "local_reference", "sha256"],
      "properties": {
        "publication_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "local_reference": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }},
    "criteria": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "service_scope", "cia_dimension", "rating", "threshold_rule", "framework_citation", "organization_approval_ref"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "service_scope": {"type": "string", "minLength": 1},
        "cia_dimension": {"enum": ["confidentiality", "integrity", "availability"]},
        "rating": {"type": "string", "minLength": 1},
        "threshold_rule": {"type": "string", "minLength": 1},
        "framework_citation": {"type": "string", "minLength": 1},
        "organization_approval_ref": {"type": "string", "minLength": 1}
      }
    }}
  }
}
