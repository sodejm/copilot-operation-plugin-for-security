{
  "$id": "urn:cops:attackpath:completion:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "additionalProperties": false,
      "properties": {
        "graph.json": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "remediation-ledger.json": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "report.json": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "report.md": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "report.json",
        "graph.json",
        "report.md",
        "remediation-ledger.json"
      ],
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "attackpath.completion/v1",
      "type": "string"
    },
    "status": {
      "const": "complete",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "files"
  ],
  "title": "Attack Path legacy report-set completion v1",
  "type": "object"
}
