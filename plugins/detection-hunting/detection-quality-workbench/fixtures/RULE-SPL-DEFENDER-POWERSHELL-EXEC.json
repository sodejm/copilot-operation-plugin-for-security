      "events": [
        {
          "_time": "2026-10-01T11:20:00Z",
          "EventCode": 4104,
          "Computer": "WORKSTATION-02.corp.internal",
          "User": "CORP\\sysadmin"
        }
      ]
    },
    {
      "case_id": "CASE-SPL-BND-SUBSTR",
