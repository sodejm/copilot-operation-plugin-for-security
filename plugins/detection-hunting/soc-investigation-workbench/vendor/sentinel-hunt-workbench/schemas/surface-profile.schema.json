{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sodejm/copilot-operation-plugin-for-security/main/plugins/detection-hunting/sentinel-hunt-workbench/schemas/surface-profile.schema.json",
  "title": "Sentinel Hunt Workbench execution-surface profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "display_name", "as_of", "support_state", "scope_contract", "allowed_operators", "allowed_functions", "unsupported_functions", "limitations", "profile_provenance", "tables"],
  "properties": {
    "id": {"enum": ["sentinel_analytics", "sentinel_data_lake", "defender_advanced_hunting"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "support_state": {"enum": ["supported", "unsupported", "unverified"]},
    "scope_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant", "workspace", "time"],
      "properties": {
        "tenant": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "time": {"type": "string", "minLength": 1}
      }
    },
    "allowed_operators": {"$ref": "#/$defs/stringArray"},
    "allowed_functions": {"$ref": "#/$defs/stringArray"},
    "unsupported_functions": {"$ref": "#/$defs/stringArray"},
    "limitations": {"$ref": "#/$defs/stringArray"},
    "profile_provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "accessed"],
        "properties": {
          "url": {"type": "string", "pattern": "^https://"},
          "accessed": {"type": "string", "format": "date"}
        }
      }
    },
    "tables": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["columns", "schema_source", "schema_as_of", "notes"],
        "properties": {
          "columns": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "schema_source": {"type": "string", "pattern": "^https://"},
          "schema_as_of": {"type": "string", "format": "date"},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
