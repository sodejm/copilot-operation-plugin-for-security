        },
        "expected_decision": {
          "type": "string",
          "enum": [
            "allowed",
            "denied",
            "inconclusive"
          ]
        },
        "expected_reason": {
          "type": "string",
          "enum": [
            "allowed",
            "audience_mismatch",
            "delegation_depth_exceeded",
            "downstream_service_mismatch",
            "expired_grant",
            "flow_mismatch",
            "missing_context",
            "missing_tenant",
            "one_time_replay",
            "operation_mismatch",
            "principal_or_agent_binding",
            "resource_mismatch",
            "revoked_grant",
            "scope_mismatch",
            "tenant_mismatch",
            "tool_not_permitted",
            "unrecognized_grant_or_actor"
          ]
        },
