{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlated peer and target authorization evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "request_id",
    "canary_id",
    "plan_digest",
    "test_identity",
    "case_id",
    "tool",
    "peer",
    "target",
    "observed_effect_count",
    "expected_decision",
    "expected_reason",
    "redacted"
  ],
  "properties": {
    "schema_version": {
      "const": "cops.agent-mcp-auth-observation/v1"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "canary_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "test_identity": {
      "const": "synthetic-fixture-runner"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "tool": {
      "type": "string",
      "enum": [
        "canary/read",
        "canary/write"
      ]
    },
    "peer": {
      "$ref": "#/$defs/peer"
    },
    "target": {
      "$ref": "#/$defs/decision"
    },
    "observed_effect_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "expected_decision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "inconclusive"
      ]
    },
    "expected_reason": {
      "type": "string",
      "enum": [
        "allowed",
        "audience_mismatch",
        "delegation_depth_exceeded",
        "downstream_service_mismatch",
        "expired_grant",
        "flow_mismatch",
        "missing_context",
        "missing_tenant",
        "one_time_replay",
        "operation_mismatch",
        "principal_or_agent_binding",
        "resource_mismatch",
        "revoked_grant",
        "scope_mismatch",
        "tenant_mismatch",
        "tool_not_permitted",
        "unrecognized_grant_or_actor"
      ]
    },
    "redacted": {
      "const": true
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "request_id",
        "canary_id",
        "plan_digest",
        "test_identity",
        "target_grant_alias",
        "decision",
        "phase",
        "reason",
        "redacted"
      ],
      "properties": {
        "schema_version": {
          "const": "cops.agent-mcp-auth-decision/v1"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "canary_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
