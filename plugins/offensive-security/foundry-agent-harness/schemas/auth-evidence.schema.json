          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test_identity": {
          "const": "synthetic-fixture-runner"
        },
        "server_identity": {
          "const": "fixed-target-authorization-service"
        },
        "target_grant_alias": {
          "type": "string",
          "enum": [
            "autonomous-write",
            "delegated-write",
            "delegated-write-fabrikam",
            "expired-write",
            "one-time-write",
            "read-only",
            "read-only-fabrikam",
            "receipt-approved-synthetic",
            "reusable-write",
            "revoked-write"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "allowed",
            "denied",
            "inconclusive"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "authentication",
            "authorization",
            "setup"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "allowed",
            "audience_mismatch",
            "delegation_depth_exceeded",
            "downstream_service_mismatch",
            "expired_grant",
            "flow_mismatch",
            "missing_context",
            "missing_tenant",
            "one_time_replay",
            "operation_mismatch",
            "principal_or_agent_binding",
            "resource_mismatch",
            "revoked_grant",
            "scope_mismatch",
            "tenant_mismatch",
            "tool_not_permitted",
            "unrecognized_grant_or_actor"
          ]
        },
        "redacted": {
          "const": true
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "request_id",
        "canary_id",
        "plan_digest",
        "test_identity",
        "server_identity",
        "kind",
        "tenant",
        "resource",
        "operation",
        "redacted",
        "case_id",
        "principal",
        "tool"
      ],
      "properties": {
        "schema_version": {
          "const": "cops.agent-mcp-auth-ledger-event/v1"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "canary_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test_identity": {
          "const": "synthetic-fixture-runner"
        },
        "server_identity": {
          "const": "fixed-target-authorization-service"
        },
        "kind": {
          "type": "string",
          "enum": [
            "canary_read",
            "canary_write"
          ]
        },
        "tenant": {
          "type": "string",
          "enum": [
            "tenant-contoso-01",
            "tenant-fabrikam-02"
          ]
        },
        "resource": {
          "type": "string",
          "enum": [
            "res-canary",
            "res-other"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "redacted": {
          "const": true
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "principal": {
          "type": "string",
          "enum": [
            "principal-alice",
            "principal-bob",
            "service-scheduler"
          ]
        },
        "tool": {
          "type": "string",
          "enum": [
            "canary/read",
            "canary/write"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "canary_read"
            },
            "operation": {
              "const": "read"
            },
            "tool": {
              "const": "canary/read"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "canary_write"
            },
            "operation": {
              "const": "write"
            },
            "tool": {
              "const": "canary/write"
            }
          }
        }
      ]
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
