        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test_identity": {
          "const": "synthetic-fixture-runner"
        },
        "peer_action": {
          "type": "string",
          "enum": [
            "mutate_operation",
            "mutate_tenant",
            "omit_tenant",
            "substitute_receipt",
            "trusted_forward"
          ]
        },
        "peer_identity": {
          "type": "string",
          "enum": [
            "hostile-forwarding-peer",
            "trusted-forwarding-peer"
          ]
        },
        "forwarded_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "attempt_id",
            "audience",
            "canary_id",
            "case_id",
            "depth",
            "downstream_service",
            "fault_mode",
            "flow",
            "grant",
            "operation",
            "plan_digest",
            "principal",
            "request_id",
            "resource",
            "scopes",
            "test_identity",
            "tick"
          ],
          "properties": {
            "grant": {
              "type": "string",
              "enum": [
                "delegated-write",
                "delegated-write-fabrikam",
                "autonomous-write",
                "one-time-write",
                "reusable-write",
                "expired-write",
                "revoked-write",
                "read-only",
                "read-only-fabrikam",
                "receipt-approved-synthetic"
              ]
            },
            "flow": {
              "type": "string",
              "enum": [
                "delegated",
                "autonomous"
              ]
            },
            "principal": {
              "type": "string",
              "enum": [
                "principal-alice",
                "principal-bob",
                "service-scheduler"
              ]
            },
            "agent": {
              "type": "string",
              "enum": [
                "agent-shadow",
                "agent-worker"
              ]
            },
            "downstream_service": {
              "type": "string",
              "enum": [
                "service-canary",
                "service-shadow"
              ]
            },
            "audience": {
              "type": "string",
              "enum": [
                "mcp://auth-fixture",
                "mcp://shadow"
              ]
            },
            "tenant": {
              "type": "string",
              "enum": [
                "tenant-contoso-01",
                "tenant-fabrikam-02"
              ]
            },
            "resource": {
              "type": "string",
              "enum": [
                "res-canary",
                "res-other"
              ]
            },
            "operation": {
              "type": "string",
              "enum": [
                "read",
                "write"
              ]
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "canary:admin",
                  "canary:read",
                  "canary:write"
                ]
              }
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "case_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 128
            },
            "request_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 128
            },
            "canary_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 128
            },
            "plan_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            },
            "test_identity": {
              "type": "string",
              "const": "synthetic-fixture-runner"
            },
            "fault_mode": {
              "type": "string",
              "enum": [
                "none",
                "hung_server",
                "missing_identity_telemetry",
                "observer_failure"
              ]
            }
          }
        },
        "forwarded_request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "redacted": {
          "const": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "request_id",
        "canary_id",
        "plan_digest",
        "test_identity",
        "case_id",
        "tool",
        "peer",
        "target",
        "observed_effect_count",
