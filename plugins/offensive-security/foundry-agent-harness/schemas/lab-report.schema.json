{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COPS local synthetic agent and MCP lab run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "all_expectations_met", "results"],
  "properties": {
    "schema_version": {"const": "cops.agent-mcp-lab-run/v1"},
    "environment": {"const": "local-synthetic-fixtures"},
    "all_expectations_met": {"type": "boolean"},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "call": {"type": "object"},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["resources", "canary_sink", "tool_response"],
      "properties": {
        "resources": {"type": "object"},
        "canary_sink": {"type": "array", "items": {"type": "string"}},
        "tool_response": {"type": "string", "maxLength": 2048}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "case_id", "title", "source_family", "attack_surface",
        "control_profile", "agent_origin", "mcp_transport", "mcp_protocol_version",
        "environment_verified", "model_text", "attempted_calls", "denied_calls",
        "executed_calls", "executed_effects", "state_before", "state_after",
        "cleanup_verified", "expected_outcome", "expectation_met"
      ],
      "properties": {
        "schema_version": {"const": "cops.agent-mcp-lab-report/v1"},
        "case_id": {"type": "string"},
        "title": {"type": "string"},
        "source_family": {"type": "string"},
        "attack_surface": {"type": "string"},
        "control_profile": {"type": "string"},
        "agent_origin": {"const": "deterministic-local-fixture"},
        "mcp_transport": {"const": "local-stdio"},
        "mcp_protocol_version": {"const": "2025-11-25"},
        "environment_verified": {"type": "boolean"},
        "model_text": {"type": "string"},
        "attempted_calls": {"type": "array", "items": {"$ref": "#/$defs/call"}},
        "denied_calls": {"type": "array", "items": {"$ref": "#/$defs/call"}},
        "executed_calls": {"type": "array", "items": {"$ref": "#/$defs/call"}},
        "executed_effects": {"type": "array", "items": {"type": "object"}},
        "state_before": {"$ref": "#/$defs/state"},
        "state_after": {"$ref": "#/$defs/state"},
        "cleanup_verified": {"type": "boolean"},
        "expected_outcome": {"enum": ["denied", "executed_effect", "executed_no_effect"]},
        "expectation_met": {"type": "boolean"}
      }
    }
  }
}
