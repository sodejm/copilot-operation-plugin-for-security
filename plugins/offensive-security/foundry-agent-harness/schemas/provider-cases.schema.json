{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COPS offline AI provider assessment cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "cops.ai-provider-assessment-cases/v1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "environment_id", "provider", "scope", "requested_tools", "request", "estimate", "response", "expected"],
        "properties": {
          "case_id": {"$ref": "#/$defs/id"},
          "environment_id": {"$ref": "#/$defs/id"},
          "provider": {"enum": ["openai", "azure", "aws", "gcp"]},
          "scope": {"$ref": "#/$defs/scope"},
          "requested_tools": {"type": "array", "uniqueItems": true, "maxItems": 16, "items": {"$ref": "#/$defs/id"}},
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canary_id", "prompt_id", "max_output_tokens"],
            "properties": {
              "canary_id": {"type": "string", "pattern": "^CANARY_[A-Z0-9_]+$"},
              "prompt_id": {"type": "string", "pattern": "^synthetic-[A-Za-z0-9._-]+$"},
              "max_output_tokens": {"$ref": "#/$defs/positive"}
            }
          },
          "estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tokens", "cost_microunits", "output_bytes"],
            "properties": {
              "tokens": {"$ref": "#/$defs/positive"},
              "cost_microunits": {"$ref": "#/$defs/positive"},
              "output_bytes": {"$ref": "#/$defs/positive"}
            }
          },
          "response": {"type": "object"},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "outcome", "response_state", "usage_state", "ledger_state"],
            "properties": {
              "decision": {"enum": ["approved", "denied", "budget_denied"]},
              "outcome": {"enum": ["completed", "tool_proposal", "no_effect"]},
              "response_state": {"enum": ["not_processed", "completed", "tool_proposal", "partial"]},
              "usage_state": {"enum": ["not_charged", "known_synthetic", "unknown"]},
              "ledger_state": {"enum": ["none", "settled", "usage_unknown"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "project_id", "region", "endpoint", "model"],
      "properties": {
        "account_id": {"type": "string", "pattern": "^synthetic-[A-Za-z0-9._-]+$"},
        "project_id": {"type": "string", "pattern": "^synthetic-[A-Za-z0-9._-]+$"},
        "region": {"$ref": "#/$defs/id"},
        "endpoint": {"type": "string", "maxLength": 256, "pattern": "^https://[A-Za-z0-9.-]+\\.invalid(?:/[A-Za-z0-9._/-]*)?$"},
        "model": {"type": "string", "pattern": "^fixture-[A-Za-z0-9._-]+$"}
      }
    }
  }
}
