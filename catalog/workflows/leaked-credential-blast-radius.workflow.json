        "outcome": {
          "source": "stage.checklist.output.outcome",
          "type": "string"
        },
        "rotation_checklist": {
          "source": "stage.checklist.output.rotation_checklist",
          "type": "array"
        }
      },
      "outputs": {
        "evidence_bundle": {
          "type": "object"
        },
        "outcome": {
          "type": "string"
        }
      },
      "retry": {
        "max_attempts": 1
      },
      "stage_id": "bundle"
