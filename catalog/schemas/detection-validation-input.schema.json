{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COPS Offline Detection Validation Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_id", "generated_at", "engagement_id", "tenant", "actions", "checks", "evidence_envelopes"],
  "properties": {
    "schema_version": {"const": "cops.detection-validation-input/v1"},
    "validation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "engagement_id": {"type": "string", "pattern": "^eng-[a-z0-9_-]{4,64}$"},
    "tenant": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action_id", "technique_id", "started_at", "ended_at", "status"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
          "technique_id": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["completed", "not_executed"]}
        }
      }
    },
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action_id", "mapping_id", "rule_id", "collection_status", "correlation_status", "clock_skew_seconds", "ingest_lag_seconds", "execution_record_id", "telemetry_record_ids", "alert_record_ids", "search_receipt_record_id"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
          "mapping_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
          "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
          "collection_status": {"enum": ["complete", "partial", "unavailable"]},
          "correlation_status": {"enum": ["exact", "ambiguous", "unavailable"]},
          "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
          "ingest_lag_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
          "execution_record_id": {"type": ["string", "null"]},
          "telemetry_record_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}},
          "alert_record_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}},
          "search_receipt_record_id": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_envelopes": {"type": "array", "maxItems": 2000, "items": {"type": "object"}}
  }
}
