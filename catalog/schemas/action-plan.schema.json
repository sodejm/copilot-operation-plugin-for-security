{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sodejm/copilot-operation-plugin-for-security/catalog/schemas/action-plan.schema.json",
  "title": "COPS Action Plan Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "engagement_id",
    "scenario_id",
    "status",
    "target",
    "specialist_id",
    "operations",
    "limits",
    "credential_references",
    "plan_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "cops.action-plan/v1"},
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[a-z0-9_-]{4,64}$"
    },
    "engagement_id": {
      "type": "string",
      "pattern": "^eng-[a-z0-9_-]{4,64}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^(scen-[a-z0-9_-]{4,64}|COPS-[A-Z0-9_.-]+)$"
    },
    "status": {
      "enum": ["draft", "pending_approval", "approved", "executing", "fulfilled", "rejected", "cancelled"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "specialist_id": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "tool", "action", "arguments", "timeout_seconds"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "tool": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "arguments": {
            "type": ["object", "array"]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "cleanup": {
            "type": "object"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "max_output_bytes", "egress_allowed"],
      "properties": {
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "egress_allowed": {"type": "boolean"}
      }
    },
    "credential_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
