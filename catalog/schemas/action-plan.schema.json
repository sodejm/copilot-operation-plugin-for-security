{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sodejm/copilot-operation-plugin-for-security/catalog/schemas/action-plan.schema.json",
  "title": "COPS Action Plan Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "engagement_id",
    "scenario_id",
    "status",
    "target",
    "specialist_id",
    "operations",
    "limits",
    "credential_references",
    "plan_digest",
    "created_at",
    "platform_prerequisites",
    "batch"
  ],
  "properties": {
    "schema_version": {
      "const": "cops.action-plan/v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[a-z0-9_-]{4,64}$"
    },
    "engagement_id": {
      "type": "string",
      "pattern": "^eng-[a-z0-9_-]{4,64}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^(scen-[a-z0-9_-]{4,64}|COPS-[A-Z0-9_.-]+)$"
    },
    "status": {
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "executing",
        "fulfilled",
        "rejected",
        "cancelled"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "specialist_id": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "tool",
          "tool_version",
          "action",
          "arguments",
          "timeout_seconds"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": [
              "object",
              "array"
            ]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "cleanup": {
            "type": "object"
          },
          "idempotent": {
            "type": "boolean"
          },
          "expected_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tool_version": {
            "type": "string",
            "minLength": 1
          },
          "egress_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["https_endpoint"],
            "properties": {
              "https_endpoint": {
                "type": "object",
                "additionalProperties": false,
                "required": ["host", "port", "identity", "request_targets"],
                "properties": {
                  "host": {"type": "string", "minLength": 1},
                  "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                  "identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["provider", "service", "account", "tenant", "cluster", "namespace", "resource"],
                    "properties": {
                      "provider": {"type": "string", "minLength": 1},
                      "service": {"type": "string", "minLength": 1},
                      "account": {"type": "string", "minLength": 1},
                      "tenant": {"type": "string", "minLength": 1},
                      "cluster": {"type": "string", "minLength": 1},
                      "namespace": {"type": "string", "minLength": 1},
                      "resource": {"type": "string", "minLength": 1}
                    }
                  },
                  "request_targets": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "platform_prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_seconds",
        "max_output_bytes",
        "egress_allowed"
      ],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "egress_allowed": {
          "type": "boolean"
        }
      }
    },
    "credential_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "max_operations",
        "fail_fast"
      ],
      "properties": {
        "mode": {
          "enum": [
            "sequential"
          ]
        },
        "max_operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "fail_fast": {
          "type": "boolean"
        }
      }
    }
  }
}
