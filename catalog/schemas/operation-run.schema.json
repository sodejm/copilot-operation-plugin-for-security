{
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "type": "number"
    },
    "attempt": {
      "minimum": 0,
      "type": "integer"
    },
    "binding_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "cancellation_requested": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_refs": {
      "items": {
        "maxLength": 512,
        "type": "string"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "expected_binding": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 96,
      "type": "string"
    },
    "lease_expires_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "lease_token": {
      "maxLength": 32,
      "type": [
        "string",
        "null"
      ]
    },
    "lease_until": {
      "type": [
        "number",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "operation_id": {
      "maxLength": 96,
      "pattern": "^cops\\.(assess|soc|work)\\.",
      "type": "string"
    },
    "operation_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "recovery_actions": {
      "items": {
        "maxLength": 96,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "request": {
      "type": "object"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "type": "string"
    },
    "schema_version": {
      "const": "cops.operation-run/v1"
    },
    "state": {
      "enum": [
        "cancelled",
        "failed",
        "partial",
        "queued",
        "running",
        "succeeded"
      ]
    },
    "updated_at": {
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "operation_id",
    "request",
    "request_digest",
    "binding_digest",
    "expected_binding",
    "state",
    "attempt",
    "cancellation_requested",
    "lease_token",
    "lease_until",
    "operation_result",
    "evidence_refs",
    "recovery_actions",
    "accepted_at",
    "updated_at"
  ],
  "type": "object"
}
