{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sodejm/copilot-operation-plugin-for-security/catalog/schemas/laboratory-environment.schema.json",
  "title": "COPS Laboratory Environment Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "environment_type",
    "status",
    "platform",
    "tool_matrix",
    "isolation",
    "canary",
    "reset_configuration",
    "owner",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "cops.laboratory-environment/v1"},
    "environment_id": {
      "type": "string",
      "pattern": "^env-lab-[a-z0-9_-]{4,64}$"
    },
    "environment_type": {
      "enum": ["container", "vm", "process_sandbox"]
    },
    "status": {
      "enum": ["registered", "verified", "active", "resetting", "torn_down", "failed"]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "distribution", "architecture", "runtime"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "distribution": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "runtime_version": {"type": ["string", "null"]}
      }
    },
    "tool_matrix": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation_type", "network_isolated", "egress_restricted", "verification_status"],
      "properties": {
        "isolation_type": {"enum": ["container_unprivileged", "vm_hypervisor", "process_isolated"]},
        "network_isolated": {"type": "boolean"},
        "egress_restricted": {"type": "boolean"},
        "verification_status": {"enum": ["unverified", "verified", "failed"]},
        "verification_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "verification_notes": {"type": ["string", "null"]}
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary_id", "canary_token", "location", "verified"],
      "properties": {
        "canary_id": {"type": "string", "minLength": 1},
        "canary_token": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "verified": {"type": "boolean"}
      }
    },
    "reset_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "reproducible"],
      "properties": {
        "strategy": {"enum": ["container_recreate", "snapshot_rollback", "script_revert"]},
        "reproducible": {"type": "boolean"},
        "command": {"type": ["string", "null"]},
        "last_reset_timestamp": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
